# Environment Variables — LeetCode Tracker
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── CORS / Frontend ───────────────────────────────────────
FRONTEND_URL=https://your-site.pages.dev

# ── CallMeBot WhatsApp ────────────────────────────────────
# No global key needed — each user stores their own CallMeBot API key
# Users activate it by sending: "I allow callmebot to send me messages"
# to +34 644 99 26 98 on WhatsApp, then paste the received key in the form.

# ── Optional: Telegram fallback ───────────────────────────
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
